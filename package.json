{
  "name": "mi-gestor-dnd",
  "version": "1.0.0",
  "description": "Mi gestor de campañas de D&D",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "jest",
    "test:watch": "jest --watch",
