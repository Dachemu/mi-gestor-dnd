# =============================================================================
# CONFIGURACIÓN DE GOOGLE DRIVE API - Mi Gestor D&D
# =============================================================================

# 🔧 INSTRUCCIONES DE CONFIGURACIÓN:
# 1. Ve a https://console.cloud.google.com/
# 2. Crea un nuevo proyecto o selecciona uno existente 
# 3. Habilita la Google Drive API
# 4. Ve a "Credenciales" → "Crear credenciales" → "ID de cliente OAuth 2.0"
# 5. Configura los orígenes autorizados:
#    - http://localhost:4000 (desarrollo)
#    - http://localhost:4001 (desarrollo alternativo) 
#    - http://127.0.0.1:4000 (desarrollo)
#    - http://127.0.0.1:4001 (desarrollo alternativo)
#    - Tu dominio de producción cuando lo tengas
# 6. También crea una "Clave de API" para acceso público

# 🔑 CREDENCIALES REQUERIDAS
# Client ID de OAuth 2.0 (formato: xxxxxx-xxxxxxxx.apps.googleusercontent.com)
VITE_GOOGLE_CLIENT_ID=

# API Key de Google Cloud Console (formato: AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXX)
# Nota: Para OAuth 2.0 no se necesita API Key, solo Client ID
VITE_GOOGLE_API_KEY=

# 🎮 CONFIGURACIÓN DE LA APLICACIÓN
# Nombre de la aplicación (aparece en la autenticación)
VITE_APP_NAME=Mi Gestor DnD

# Modo debug (true/false) - muestra logs adicionales en desarrollo
VITE_DEBUG=true

# 📁 CONFIGURACIÓN DE GOOGLE DRIVE
# Nombre de la carpeta que se creará en Drive
VITE_DRIVE_FOLDER_NAME=Mi Gestor DnD

# Intervalo de auto-sync en minutos (default: 5)
VITE_AUTO_SYNC_INTERVAL=5

# 🚀 CONFIGURACIÓN DE DESARROLLO
# Habilitar funcionalidades de sync sin credenciales (true/false)
VITE_ENABLE_MOCK_SYNC=false

# Google App ID (solo los números del Client ID)
VITE_GOOGLE_APP_ID=

# URL de desarrollo (se detecta automáticamente, solo cambiar si es necesario)
# VITE_DEV_URL=http://localhost:4000

# =============================================================================
# NOTAS IMPORTANTES:
# - Nunca commites las credenciales reales al repositorio
# - Copia este archivo como .env y rellena las credenciales
# - Las variables VITE_ son públicas en el cliente, no pongas secretos aquí
# - Para producción, configura estas variables en tu hosting provider
# =============================================================================